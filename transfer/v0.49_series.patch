+ if(cat==='birds')return {sub:/フクロウ|ミミズク/.test(n)?'owl':'bird',scene:'branch',many:/合唱|群れ|鳥たち/.test(n)};
+ if(cat==='aquatic'){if(/クジラ|シャチ/.test(n))return {sub:'whale',scene:'sea',many:/シャチ|群れ/.test(n)};if(/イルカ/.test(n))return {sub:'dolphin',scene:'sea',many:/群れ|カリブ|声/.test(n)};
