+                    'pcmDataSha256': sha(a)},
+            'compat': {'path': mp3_rel, 'bytes': len(mb), 'sha256': sha(mb), 'format': 'mp3', 'codec': 'MP3 128kbps', 'sampleRate': src_c, 'channels': 1,
