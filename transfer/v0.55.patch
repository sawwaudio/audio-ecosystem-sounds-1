+        info = sf.info(src)
+        x, sr = sf.read(src, always_2d=True)
+        bits = {'PCM_16': 16, 'PCM_24': 24}[info.subtype]
+        base = re.sub(r'[^A-Za-z0-9_.-]', '', os.path.basename(path).replace('#', 's'))
