+    sys.exit('integrate_v048_nature: ' + m)
+
+
+def once(old, new):
+    global t
+    if new in t:
+        return
+    if t.count(old) != 1:
+        die('置き換え対象が %d 件: %r' % (t.count(old), old[:90]))
+    t = t.replace(old, new)
+
+
+# ── 1. 配色（v0.47 の青紫とポップな色 → 夕方の森と琥珀色）──
