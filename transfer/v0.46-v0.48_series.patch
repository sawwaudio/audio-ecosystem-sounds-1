+
+def recolor(css):
+    css = re.sub(r'#[0-9a-fA-F]{6}\b', lambda m: COLORS.get(m.group(0).lower(), m.group(0)), css)
+    for a, b in RGBA.items():
+        css = css.replace(a, b)
+    return css
+
+
+for m in reversed(list(re.finditer(r'<style( id="ae-studio-css")?>(.*?)</style>', t, re.S))):
