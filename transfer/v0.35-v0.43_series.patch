+.tileSub{font:italic 10px/1.2 Georgia,serif;color:#d0ddd6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.tileTier{position:absolute;left:6px;top:6px;font:700 9px ui-monospace,monospace;padding:2px 5px;border-radius:6px;background:rgba(0,0,0,.55);color:#d6efc8}
