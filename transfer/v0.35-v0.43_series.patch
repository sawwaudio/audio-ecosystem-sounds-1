+.planCard{border:1px solid #31484a;border-radius:12px;padding:12px;background:#0e1f21}
+.planCard.plan-pro{border-color:#d6efc8}
+.planName{font:700 14px ui-monospace,monospace;letter-spacing:.08em}
+.planTag{font-size:12px;color:var(--muted);margin-top:2px}
+.planPrice{font:600 24px ui-monospace,monospace;margin-top:8px}
+.planNote{margin-top:6px}
+.planTable{width:100%;border-collapse:collapse;margin-top:10px;font-size:11px}
+.planTable th,.planTable td{border-bottom:1px solid #263b3e;padding:6px 4px;text-align:left}
+.planTable .mk,.planTable th:not(:first-child){text-align:center;width:52px}
+.proChip{display:inline-block;margin-left:6px;padding:1px 6px;border-radius:8px;border:1px solid #d6efc8;color:#d6efc8;font:700 9px ui-monospace,monospace;letter-spacing:.08em;vertical-align:middle}
