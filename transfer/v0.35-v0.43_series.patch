+@keyframes tileBreath{0%,100%{transform:scale(1)}50%{transform:scale(1.045)}}
+@media (prefers-reduced-motion:reduce){.tile.on .tileImg img,.tile.on .tileImg .ph{animation:none}}
+.phLabel{position:absolute;left:8px;top:8px;font:600 9px ui-monospace,monospace;letter-spacing:.12em;color:rgba(230,242,234,.75)}
